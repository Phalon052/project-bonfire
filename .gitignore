# ── Project Bonfire ──────────────────────────────────────────
# Keep only the top-level files in these folders (guides, templates,
# generated views); ignore every subfolder inside them.
catalog/model library/*/
catalog/hardware inventory/*/

# To track the CSV data after all, uncomment:
# !catalog/model library/data/
# !catalog/hardware inventory/data/

# Blender backups and autosaves
*.blend1
*.blend2
*.blend@
*.autosave.blend
quit.blend

# Sliced print files
*.gcode
*.gcode.3mf

# Secrets / local config
.env
.env.*
!.env.example
# The desktop app mirrors anything Claude writes to its outputs folder into
# here, with the leading dot stripped - so a copy of .env lands as `env`.
Claude outputs*/
env
*.key
tools/bambu_config.local.json
# Bambu Cloud sign-in token (tools/bambu_cloud.py login)
tools/bambu_cloud.local.json
tools/bambu_cloud.local.json.tmp
# One-time print approval codes (tools/bambu_print.py)
tools/bambu_print.local.json
# P1S camera snapshots (pictures of your printer / room)
tools/camera_snapshots/
# Bambu Studio preset template — saved from your own Studio, so it's per-machine
# (and Studio writes your account number into it). See bambu_presets.py.
tools/bambu_template.3mf

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Editors ──────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# ── OS ───────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ── Office lock files (CSV open in Excel) ────────────────────
~$*
.~lock.*#

# ── Misc ─────────────────────────────────────────────────────
# Local scratch / working notes — not part of the project
development/
TODO.md
BAMBU_MCP_PLAN.md
# Generated views of personal data
catalog/model library/projects.md
catalog/hardware inventory/inventory_count.md
